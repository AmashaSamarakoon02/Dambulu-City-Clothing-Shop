generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String
  bio        String?
  phone      String?
  role       String   @default("USER") // ADMIN, EMPLOYEE, USER

  // Email verification & password recovery (tokens stored as SHA-256 hashes)
  isVerified               Boolean   @default(false)
  verificationToken        String?   @unique
  verificationTokenExpires DateTime?
  resetPasswordToken       String?   @unique
  resetPasswordExpires     DateTime?

  // User (customer) specific
  address    String?

  // Employee specific
  department String?
  employeeId String?  @unique

  // Delivery specific
  vehicleType String?
  deliveryZone String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews    Review[]
  orders     Order[]
  wishlist   WishlistItem[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique // stored in Product.category
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String   @default("")
  price         Float
  originalPrice Float?
  image         String   // main image (= images[0])
  images        String[] @default([])
  category      String   // Category.slug
  brand         String?
  isNewArrival  Boolean  @default(false)
  isBestSeller  Boolean  @default(false)
  colors        String[]
  sizes         String[]
  stock         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]
  orderItems    OrderItem[]
  wishlistedBy  WishlistItem[]
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerName    String?
  phone           String?
  email           String?
  subtotal        Float       @default(0)
  deliveryFee     Float       @default(0)
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  deliveryAddress String      // JSON: { line1, city, postalCode, instructions }
  paymentMethod   String      // COD, CARD, BANK_TRANSFER
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshots so order history survives product edits/deletion
  productName  String   @default("")
  productImage String   @default("")
  quantity     Int
  price        Float
  color        String?
  size         String?
}
