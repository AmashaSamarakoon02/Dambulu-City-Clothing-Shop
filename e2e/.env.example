# Copy to .env and fill in. Never commit .env.
# Public production domain. Preview URLs (…-<hash>-amasha2.vercel.app) are behind
# Vercel Deployment Protection and redirect to the Vercel login.
BASE_URL=https://dambulu-city-clothing-shop.vercel.app
API_URL=https://dambulu-city-clothing-shop-production.up.railway.app/api
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Set to 1 to also run @writes tests (create real users/orders). Leave unset on production.
RUN_WRITES=
# Only needed to test a protected Vercel PREVIEW URL as BASE_URL.
# Vercel: Project > Settings > Deployment Protection > Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=
