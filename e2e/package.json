{
  "name": "dambulla-city-clothing-qa",
  "version": "1.0.0",
  "description": "Playwright UI + API automation (POM) for Dambulla City Clothing Shop",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:smoke": "playwright test --grep @smoke",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:allure": "node scripts/test-allure.mjs",
    "allure:generate": "node scripts/redact-allure-results.mjs && allure generate allure-results",
    "allure:open": "allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-js-commons": "^3.15.0",
    "allure-playwright": "^3.15.0",
    "typescript": "^7.0.2"
  }
}
